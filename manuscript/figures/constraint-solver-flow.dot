digraph ConstraintSolverFlow {
  graph [
    rankdir=TB,
    bgcolor="transparent",
    pad="0.18",
    nodesep="0.42",
    ranksep="0.54",
    splines=polyline
  ];
  node [
    shape=box,
    style="rounded,filled",
    fontname="Helvetica",
    fontsize=10,
    color="#45616d",
    fontcolor="#152028",
    fillcolor="#e8f2f4",
    margin="0.14,0.09",
    width=2.15
  ];
  edge [color="#39869a", fontname="Helvetica", fontsize=8, fontcolor="#31545e", arrowsize=0.65, penwidth=1.1];

  state [label="Simulation state\nlinks, revolutes, slots, servo", fillcolor="#eef3e8"];
  graph_model [label="Constraint graph\nworld, bodies, constraints"];
  analysis [label="Component analysis\nconnectivity, rank, mobility"];
  analytic [label="Analytic propagation\nseeds, rigid poses, dyads"];
  numerical [label="Bounded numerical solve\nonly for constrained remainder"];
  contact [label="Finger and contactor IK\nspecialized two-contact stage"];
  collision [label="Collision and invariant checks"];
  render [label="Valid snapshot and rendering", fillcolor="#eef3e8"];

  state -> graph_model [constraint=false];
  graph_model -> analysis [constraint=false];
  analysis -> analytic [constraint=false];
  analytic -> numerical [constraint=false, label="zero-DOF remainder"];
  analytic -> contact [style=dashed, weight=20, label="closed or free"];
  numerical -> contact [constraint=false];
  contact -> collision [constraint=false];
  collision -> render [constraint=false];

  state -> analysis [style=invis, weight=20];
  analysis -> numerical [style=invis, weight=20];
  numerical -> collision [style=invis, weight=20];
  graph_model -> analytic [style=invis, weight=20];
  contact -> render [style=invis, weight=20];
}
