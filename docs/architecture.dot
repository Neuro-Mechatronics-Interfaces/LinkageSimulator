digraph LinkageSimulatorArchitecture {
  graph [rankdir=LR, bgcolor="transparent", pad="0.2", nodesep="0.45", ranksep="0.65"];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=11, color="#45616d", fontcolor="#d9e4e8", fillcolor="#152028", margin="0.15,0.1"];
  edge [color="#63b8c8", arrowsize=0.7, penwidth=1.2];

  main [label="main.ts\nloop + composition", fillcolor="#17313a"];
  ui [label="ui/\ninteraction + JSON download"];
  simulation [label="simulation/\nkinematics + gravity statics"];
  rendering [label="rendering/\nCanvas only"];
  model [label="model/\ntyped state + export schema", fillcolor="#202b29"];
  geometry [label="geometry/\npure 2-D math", fillcolor="#202b29"];

  main -> ui;
  main -> simulation;
  main -> rendering;
  ui -> model;
  ui -> geometry;
  simulation -> model;
  simulation -> geometry;
  rendering -> model;
  rendering -> geometry;
}
