digraph LinkageDesignOptimization {
  graph [
    rankdir=TB,
    bgcolor="transparent",
    pad="0.22",
    nodesep="0.48",
    ranksep="0.62",
    splines=polyline
  ];
  node [
    shape=box,
    style="rounded,filled",
    fontname="Arial",
    fontsize=11,
    color="#45616d",
    fontcolor="#d9e4e8",
    fillcolor="#152028",
    margin="0.16,0.11",
    width=2.25
  ];
  edge [
    color="#63b8c8",
    fontname="Arial",
    fontsize=9,
    fontcolor="#45616d",
    arrowsize=0.7,
    penwidth=1.2
  ];

  design [label="Design variables d\nlengths + attachments + bounds", fillcolor="#202b29"];
  samples [label="Pose samples k\nservo commands + distal targets", fillcolor="#202b29"];
  solve [label="Converged mechanism states\nr(q_k, d, phi_k) = 0", fillcolor="#17313a"];
  linearize [label="Local linearization\nJ_q + J_d"];
  guard [label="Rank / active-set guard\nbranch + finite checks"];
  sensitivity [label="Implicit sensitivity\nJ_q S = -J_d"];
  objective [label="Multi-pose objective\ncontact error + regularizers"];
  optimizer [label="Bounded optimizer\ndesign update"];

  design -> solve [weight=20];
  samples -> solve [constraint=false];
  solve -> linearize [constraint=false];
  linearize -> guard [constraint=false];
  guard -> sensitivity [constraint=false, label="regular branch"];
  sensitivity -> objective [constraint=false];
  samples -> objective [constraint=false, style=dashed, label="targets"];
  objective -> optimizer [constraint=false, label="total gradient"];
  optimizer -> design [constraint=false, label="next candidate"];

  solve -> guard [style=invis, weight=20];
  guard -> objective [style=invis, weight=20];
  samples -> linearize [style=invis, weight=20];
  linearize -> sensitivity [style=invis, weight=20];
  sensitivity -> optimizer [style=invis, weight=20];
}
