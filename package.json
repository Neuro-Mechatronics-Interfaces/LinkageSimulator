{
  "name": "linkage-simulator",
  "version": "0.1.0",
  "private": true,
  "description": "Interactive planar linkage simulator for servo-driven finger mechanisms.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
